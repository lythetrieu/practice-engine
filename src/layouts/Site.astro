// schema, noindex, ogImage) and `page` (see components/site/Base.astro).
import Base from '../components/site/Base.astro';
import type { Props as BaseProps } from '../components/site/Base.astro';

export type Props = BaseProps;
---
<Base {...Astro.props}><slot name="head" slot="head" /><slot /></Base>
