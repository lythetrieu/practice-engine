---
// Every /admin/ address that is not a real admin page answers with the site's own 404 page. The admin pages rewrite to
// this route when the visitor is not an admin (src/lib/server/admin.ts adminGate), so a visitor who is not an admin
// gets exactly the page any other missing address gets, and cannot tell the admin area exists. The same markup as
// src/pages/404.astro, with the 404 status (a prerendered page cannot be the target of a rewrite from a server-rendered one).
import Site from '../../layouts/Site.astro';
import { config } from '../../pack';
export const prerender = false;

Astro.response.status = 404;
Astro.response.headers.set('cache-control', 'no-store');
Astro.response.headers.set('x-robots-tag', 'noindex');
---
<Site title={`Page not found | ${config.name}`} description="This page does not exist." path="/404" noindex>
  <p class="eyebrow">Error 404</p>
  <h1>That page does not exist</h1>
  <p class="lede">The link may be old or mistyped. Here is where you can go.</p>
  <div class="row" style="margin:24px 0 8px">
    <a class="btn primary" href="/">Go to the home page</a>
    <a class="btn" href="/app/">Practice</a>
    <a class="btn" href="/account/">Account</a>
  </div>
</Site>
