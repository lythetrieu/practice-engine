{
  "name": "practice-engine",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "A practice-test app for any exam: add a test pack (questions + a config file) and run it on Cloudflare Workers and D1.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/pack.mjs dev",
    "build": "node scripts/pack.mjs build",
    "validate": "node scripts/pack.mjs validate",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/andika": "^5.3.0",
    "@fontsource/charis-sil": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "js-yaml": "^4.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "uqr": "^0.1.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.144.0"
  }
}
